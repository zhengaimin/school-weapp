# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = true

# 第一个请求地址
# VITE_SERVER_BASEURL = 'http://192.168.110.249:8686'
# VITE_SERVER_BASEURL = 'http://47.120.20.136:8085'
# VITE_SERVER_BASEURL = 'https://school.geniuscarbon.cn'
VITE_SERVER_BASEURL = 'https://golanghub.top'
# VITE_SERVER_BASEURL = 'http://192.168.110.217:8686'
# VITE_SERVER_BASEURL = 'http://192.168.31.154:8686'
# VITE_SERVER_BASEURL = 'https://www-nas.u2317964.nyat.app:29546'

# 第二个请求地址
# VITE_API_SECONDARY_URL = 'http://192.168.110.249:8686'
# VITE_API_SECONDARY_URL = 'http://192.168.110.249:8683'
# VITE_API_SECONDARY_URL = 'http://localhost:8686'

# VITE_UPLOAD_BASEURL = 'http://localhost:8686'
# VITE_UPLOAD_BASEURL = 'http://192.168.110.249:8683'
VITE_UPLOAD_BASEURL = 'https://golanghub.top'

# 有些同学可能需要在微信小程序里面根据 develop、trial、release 分别设置上传地址，参考代码如下。
# 下面的变量如果没有设置，会默认使用 VITE_SERVER_BASEURL or VITE_UPLOAD_BASEURL
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = ''
VITE_SERVER_BASEURL__WEIXIN_TRIAL = ''
VITE_SERVER_BASEURL__WEIXIN_RELEASE = ''

VITE_UPLOAD_BASEURL__WEIXIN_DEVELOP = ''
VITE_UPLOAD_BASEURL__WEIXIN_TRIAL = ''
VITE_UPLOAD_BASEURL__WEIXIN_RELEASE = ''