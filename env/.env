VITE_UNI_APPID = '__UNI__D1E5001'
VITE_WX_APPID = 'wxd306b4755df39867' # 捷碳 AppID
# VITE_WX_APPID = 'wxf86491ae0549468c' # 鑫智擎 AppID

# h5部署网站的base，配置到 manifest.config.ts 里的 h5.router.base
VITE_APP_PUBLIC_BASE=/

# 登录页面
VITE_LOGIN_URL = '/pages/login/index'

# h5是否需要配置代理
VITE_APP_PROXY=true
VITE_APP_PROXY_PREFIX = '/dev-api'

# VOIP 的两个变量
VITE_APP_DEP_UUID = 'CUA6146DA7939411F0B03B00163E1CE4B9'
VITE_APP_VOIP_APPID = 'wx577bb6f100f10192'

# H5 则根据 .env.development、.env.production 环境变量，分别设置不同的代理地址。
# 微信小程序根据 develop、trial、release 分别设置上传地址，参考代码如下。
# VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://192.168.1.13:8686'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://golanghub.top'
# VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://xzsh.stufree.com'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://xzsh.stufree.com'
