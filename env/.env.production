# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 第一个请求地址
VITE_SERVER_BASEURL = 'https://xzsh.stufree.com'
# 第二个请求地址
# VITE_API_SECONDARY_URL = 'https://xzsh.stufree.com'

VITE_UPLOAD_BASEURL = 'https://xzsh.stufree.com'
