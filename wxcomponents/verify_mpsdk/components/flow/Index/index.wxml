<view class="index-container {{theme}}"><view class="index-top"><view class="index-hint">您即将进行</view><view class="index-title">{{cmsConfig.page.index.clientName}}</view><view class="index-title">{{cmsConfig.page.index.businessName}}</view><view class="index-cert" style="margin-top:13rpx">{{cmsConfig.page.index.certificationCenter}}</view></view><view class="index-auth-protocol"><view class="check-protocol" bindtap="checkboxChange"><view class="check-protocol-box {{indexDisableBtn ? '':'checked'}}"></view></view><view><label bindtap="checkboxChange">{{cmsConfig.page.index.authorizedProtocol}}</label> <label class="color" bindtap="switchIndexRule">《{{cmsConfig.page.index.protocolTitle}}》</label></view></view><view class="protocol-container"><view class="index-btn"><button class="common-btn primary" type="primary" bindtap="indexToNext" disabled="{{indexDisableBtn}}" hover-class="btn-hover">{{cmsConfig.page.index.nextBtnName}}</button></view><view class="index-risk-tip"><slot/></view></view><dialog wx:if="{{index_rule}}" title="{{cmsConfig.protocol.title}}" confirm-color="{{dialogConfig.confirmColor}}" confirm-text="我知道了" show-cancel="{{false}}" bindclose="switchIndexRule" bindconfirm="switchIndexRule"><view class="protocol-content"><rich-text nodes="{{cmsConfig.protocol.clientContent}}" style="text-indent: 25px;"></rich-text><view wx:if="{{cmsConfig.protocol.clientContent}}" class="line"></view><view wx:if="{{cmsConfig.protocol.content}}"><rich-text nodes="{{cmsConfig.protocol.content}}" style="text-indent: 25px;"></rich-text></view></view></dialog></view>