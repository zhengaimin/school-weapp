<view class="{{theme}} result"><block wx:if="{{loading}}"></block><block wx:elif="{{resultInfo.pageType === 'IntentionVerify'}}"><block wx:if="{{resultStatus === 'success'}}"><view class="icon-box {{theme}}"><icon class="icon-box-img" type="success" size="93" color="{{ theme === 'theme-green' ? '#1aad19' : '#0079ff'}}"></icon><view class="icon-box-ctn"><view class="icon-box-title">采集完成</view></view><view class="bottom-btns"><button type="primary" class="common-btn w100 pdd0" bindtap="asrResultFinish">下一步</button></view></view></block><block wx:if="{{resultStatus === 'error'}}"><view class="icon-box"><icon class="icon-box-img" type="warn" size="93"></icon><view class="icon-box-ctn"><view class="icon-box-title">{{resultMsg}}</view></view><view class="bottom-btns" wx:if="{{showTryBtn}}"><button wx:if="{{resultCode !== 3104}}" class="btn-checkVoice common-btn" type="primary" plain="true" style="margin-right:20px" bindtap="handleCheckVoice">检测麦克风</button> <button type="primary" class="common-btn" bindtap="failReVerify">重新尝试</button></view><view class="bottom-btns" wx:else><button class="common-btn w100" type="primary" bindtap="asrResultFinish">退出检测</button></view></view></block><view class="loading" wx:if="{{resultStatus === 'loading'}}"><view class="loading-img"><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/others/20200615194418_YXoS5wuxyu.png" class="rotate-img"></image></view><view class="loading-text">Loading...</view></view></block><block wx:else><block wx:if="{{resultInfo.code === 0}}"><view class="success"><view class="verifyResultTop"><icon type="success" size="75"></icon></view><view class="verifyResultSuccess">{{cmsConfig.page.success.successTitle}}</view><view class="verifyResultHint">{{cmsConfig.page.success.successTips}}</view><view class="verifyResultHint">{{cmsConfig.page.success.successTips2}}</view><view class="index-btn" style="margin-top:135rpx"><button class="common-btn" type="primary" bindtap="successGoToNext" hover-class="btn-hover">下一步</button></view></view></block><block wx:else><view class="fail"><block wx:if="{{resultInfo.img}}"><view class="verifyFailTop"><image src="{{resultInfo.img}}" style="width: 180px;height: 113px;"></image></view><view class="verifyFailWarn"><icon class="icon-box-img" type="warn" size="20"></icon><view style="margin-left:8px;">验证失败: {{resultInfo.msg}}</view></view></block><block wx:else><view class="verifyResultTop"><icon type="warn" size="75"></icon></view><view class="verifyResultSuccess" style="width:auto;padding:0 20px;">验证失败: {{resultInfo.msg}}</view></block><block wx:if="{{!resultInfo.img}}"><view wx:if="{{resultInfo.tips1}}" class="verifyResultHint {{resultInfo.isTips1Color ? 'color-blue' : ''}}" style="margin-bottom:1px;">{{resultInfo.tips1}}</view><view wx:if="{{resultInfo.tips2}}" class="verifyResultHint">{{resultInfo.tips2}}</view></block><view class="index-btn" style="margin-top:135rpx"><button class="common-btn" wx:if="{{!isHideRetry}}" type="primary" bindtap="failReVerify" hover-class="btn-hover">{{cmsConfig.page.failpage.RetryBtnText}}</button> <button wx:if="{{resultInfo.pageType !== 'Livingbody'}}" class="common-btn" type="primary" plain style="margin-top:40rpx" bindtap="handleBack" hover-class="btn-hover">退出验证</button></view><block wx:if="{{resultInfo.pageType === 'Livingbody'}}"><view class="page-body-link" openType="switchTab" bindtap="switchfailModal" wx:if="{{livingbodyType === 0}}" style="margin-top:10px;">查看规范视频</view><view class="page-body-link color" bindtap="verifyBackToIndex" style="margin-top:3px">回到首页</view></block></view></block><view class="index-risk-tip"><slot/></view></block><dialog wx:if="{{is_modal_showing}}" theme="transparent" opacity="{{0.8}}" title="规范视频" confirm-text="我知道了" show-cancel="{{false}}" bindconfirm="switchfailModal"><view class="livingbody-dialog-bg"><video src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/video/number.mp4" style="width:100%;margin-top:4px;" show-fullscreen-btn="{{false}}" autoplay="true"></video></view></dialog></view>