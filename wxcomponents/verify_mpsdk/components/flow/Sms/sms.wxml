<import src="../../../templates/riskTip/riskTip.wxml"></import><view class="verify-white-bg {{theme}}"><view class="sms-top"><view class="risk-tip-container"><slot/></view><view id="sms-top-phone" class="sms-top-sec"><view class="sms-input-title">手机号</view><view class="sms-ts-input"><input type="number" focus="true" name="phoneNum" bindinput="phoneNumChanged" maxlength="11" placeholder="请输入手机号"/></view><view wx:if="{{is60sGap}}"><view class="sms-ts-btn">倒计时{{gapSec}}s</view></view><view wx:else><view class="sms-ts-btn color" wx:if="{{isEnableSendSms}}" bindtap="sendVerifyCodeReq">{{sendSmsTtitle}}</view><view class="sms-ts-btn" wx:else>{{sendSmsTtitle}}</view></view></view><view class="sms-top-sec"><view class="sms-input-title">验证码</view><view class="sms-ts-input"><input type="number" name="verifyCode" maxlength="4" placeholder="请输入验证码" bindinput="verifyCodeChanged"/></view></view><view class="hint-error">{{hintError}}</view></view><view class="sms-bottom"><view class="index-btn"><button class="common-btn" disabled="{{isForbiddenSmsBtn}}" type="primary" bindtap="smsToNext" hover-class="common-btn-hover">下一步</button></view></view></view>