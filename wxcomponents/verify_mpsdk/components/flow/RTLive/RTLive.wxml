<import src="./template/Guid.wxml"></import><block wx:if="{{!loading}}"><block wx:if="{{isShowGuide}}"><template is="rtLiveGuide" data="{{...cmsConfig,theme}}"/></block><block wx:else><view class="container"><view class="video-container {{theme}}"><view class="video-mask" ref="videoMask"><image class="border" src="./videoBottom.png"></image><image class="prepare" src="https://faceid-h5-1254418846.cos.ap-guangzhou.myqcloud.com/images/LiveReflect1V1/grayPerson.png"></image></view><block wx:if="{{comparing}}"><loading theme="{{theme}}" style="margin-top:-26rpx;z-index: 6" size="l"></loading></block><block wx:if="{{isCameraOk}}"><camera bindinitdone="handleCameraInit" binderror="handleCameraError" device-position="front" frame-size="medium" flash="off" style="width: 580rpx; height:580rpx;over-flow:hidden"></camera></block></view><canvas type="2d" id="capture" style="width: 0px; height: 0px;"></canvas><view class="top-tips" style="z-index:{{isChangeColor ? 1 : 6}}, color: {{toastColor}}">{{toastMessage}}</view><view class="guide-overlay"><view class="guide-overlay-shape" style="box-shadow: 0 0 0 99999rpx {{currentColorRgba}}"></view></view></view></block></block>