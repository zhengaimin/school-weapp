<view class="nfc-container"><view class="tips-img-container"><view class="animation-part {{status}}"><image mode="widthFix" class="idcard" src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/nfc/animation/idcard.png"/><image mode="widthFix" class="phone" src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/nfc/animation/phone.png"/><view class="nfc-part success"><view class="nfc-wifi wifi"></view></view><view class="nfc-part error"><view class="nfc-wifi wifi"></view></view><view class="icon icon-success"></view><view class="icon icon-error"></view><image mode="widthFix" class="circle circle1" src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/nfc/circle-1.png"/><image mode="widthFix" class="circle circle2" src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/nfc/circle-2.png"/></view></view><view class="tips-container" hover-class="none" hover-stop-propagation="false"><view class="tips1">{{nfcTips[status].tips1}}</view><view class="tips2">{{nfcTips[status].tips2}}</view><block wx:if="{{status === 'waiting'}}"><button class="verify-btn" type="primary" bindtap="eIDreadCardNfcStart">开始验证</button></block></view><dialog wx:if="{{dialogConfig.visible}}" title="{{dialogConfig.title}}" show-confirm="{{dialogConfig.showConfirm}}" confirm-color="{{dialogConfig.confirmColor}}" cancel-color="{{dialogConfig.cancelColor}}" confirm-text="{{dialogConfig.confirmText}}" show-cancel="{{dialogConfig.showCancel}}" cancel-text="{{dialogConfig.cancelText}}" bindclose="handleCloseDialog" bindcancel="handleCancelDialog" bindconfirm="handleConfirmDialog"><view style="height:140rpx;text-align: center;padding: 0 60rpx;color:rgba(0, 0, 0, 0.6);"><rich-text nodes="{{dialogConfig.content}}"></rich-text></view></dialog></view>