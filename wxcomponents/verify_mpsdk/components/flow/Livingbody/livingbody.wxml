<view class="{{theme}} {{themeLayout}}" hover-class="none" hover-stop-propagation="false"><view wx:if="{{isShowGuide && !isShowCamera}}"><view class="livingbody-guide-title">实名核身验证流程</view><view class="livingbody-guide-imgview" wx:if="{{livingbodyType === 0}}"><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/hint-heshen-number.png"></image></view><view class="livingbody-guide-imgview" wx:elif="{{livingbodyType === 1}}"><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/hint-heshen-action.png"></image></view><view class="livingbody-guide-imgview" wx:else><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/hint-heshen-silent.png"></image></view><view class="index-btn" class="livingbody-guide-btnview"><button class="common-btn" type="primary" bindtap="livingbodyStartToRecord" hover-class="common-btn-hover" disabled="{{isNotPrepareOk}}">开始识别</button></view><view class="livingbody-guide-showdialog"><text bindtap="switchLivingbodyDialog" style="padding:5px 10px">查看规范</text></view><view class="livingbody-risk-tip"><slot name="default"/></view></view><view wx:if="{{isShowCamera}}" style="position:absolute;top:0;bottom:0;width:100%;"><camera device-position="front" flash="off" binderror="ocrCameraError" bindinitdone="liveCameraDone" bindstop="bindstop" class="livingbody-camera" style="position:absolute;top:0;bottom:0;width:100%;height:100%"><cover-view class="livingbody-title"><cover-view class="livingbody-risk-tip"><cover-view wx:if="{{cmsConfig.Common.RiskTip}}" class="risk-tip">{{cmsConfig.Common.RiskTip}}</cover-view></cover-view><cover-view>{{livingbodyTitle}}</cover-view></cover-view><cover-image src="{{'https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/livingbody/faceyzbg-' + themeLayout + '.png'}}" class="livingbody-bg"></cover-image><block wx:if="{{livingbodyType === 0}}"><cover-view class="livingbody-number-pre" wx:if="{{isPrepare}}">准备读数...</cover-view><cover-view class="livingbody-number-hint" wx:else><cover-view class="lvingbody-number-text {{curNumberStatus[0]}}">{{curNumber[0]}}</cover-view><cover-view class="lvingbody-number-text {{curNumberStatus[1]}}">{{curNumber[1]}}</cover-view><cover-view class="lvingbody-number-text {{curNumberStatus[2]}}">{{curNumber[2]}}</cover-view><cover-view class="lvingbody-number-text {{curNumberStatus[3]}}">{{curNumber[3]}}</cover-view></cover-view></block><block wx:elif="{{livingbodyType === 1}}"><cover-view class="livingbody-action-pre" wx:if="{{isPrepare}}">准备做动作...</cover-view><cover-view class="livingbody-action-hint" wx:else>{{livingbodyActionText}}</cover-view></block><block wx:else><cover-view class="livingbody-silent"><cover-view class="livingbody-silent-view"><cover-view class="livingbody-silent-prepare" wx:if="{{isPrepare}}">准备录制</cover-view><block wx:else><cover-view class="livingbody-silent-hintone">录制中</cover-view><cover-view class="livingbody-silent-hinttwo">{{livingbodySilentText}}</cover-view></block></cover-view></cover-view></block></camera></view><view wx:if="{{isShowProcess && !isShowGuide && !isShowCamera}}" class="livingbody-process"><view class="scan"><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/loadding-white.gif"></image></view><view class="livingbody-process-m"><progress percent="{{uploadProcess}}" color="#2473e9" backgroundColor="#cbcbcb" stroke-width="6"></progress></view><view class="livingbody-process-title">系统识别中...</view><view class="livingbody-risk-tip"><slot name="default"/></view></view><dialog wx:if="{{isShowDialog}}" theme="transparent" opacity="{{0.8}}" title="视频录制规范" confirm-color="{{dialogConfig.confirmColor}}" confirm-text="我知道了" show-cancel="{{false}}" confirm-border="{{dialogConfig.confirmBorder}}" dialog-bg-color="{{dialogConfig.dialogBgColor}}" confirm-background-color="{{dialogConfig.confirmBackgroundColor}}" title-color="{{dialogConfig.titleColor}}" bindconfirm="switchLivingbodyDialog"><view class="livingbody-dialog-bg"><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/v1videohint.png" mode="widthFix"></image></view></dialog></view>