.theme-green .nav-active{background:#1aad19}.theme-blue .nav-active{background:#2d72f1}.nav-unActive{background:#f3f3f3;color:#848484}.nav-active{color:#fff}.nav-step{padding:60rpx 30rpx 40rpx;justify-content:center;display:flex;justify-content:center}.nav-step.block{background-color:transparent;color:transparent}.nav-step.block .nav-stepLine{border-bottom:8rpx solid transparent}.nav-step.block .nav-lineActive{border-bottom:4rpx solid transparent}.nav-step.block .nav-stepStatus,.nav-step.block .nav-stepStatusUnActive{color:transparent}.nav-step.block .nav-active,.nav-step.block .nav-unActive{background:0 0;color:transparent}.nav-item{float:left;font-size:32rpx;text-align:center;position:relative;flex:1;width:auto;z-index:6}.nav-icon{border-radius:50%;margin:0 auto;position:relative;z-index:888;width:48rpx;height:48rpx;line-height:48rpx;font-weight:700;font-size:32rpx}.nav-stepLine{position:absolute;top:20rpx;left:50%;border-bottom:8rpx solid #f3f3f3;width:100%}.nav-lineActive{border-bottom:4rpx solid #f3f3f3}.nav-stepStatus{line-height:40rpx;font-weight:400;font-size:28rpx;text-align:center;padding-top:16rpx;color:#000}.nav-stepStatusUnActive{line-height:40rpx;font-weight:400;font-size:28rpx;text-align:center;padding-top:16rpx;color:#999}