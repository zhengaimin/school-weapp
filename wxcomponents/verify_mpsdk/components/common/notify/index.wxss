.notify-view{position:fixed;top:0;width:100%;z-index:1999;opacity:0;transition:all .5s}.active{opacity:1}.warning .notify-content-view{background-color:red}.success .notify-content-view{background-color:#1aad19}.notify-content-view{padding:20rpx;background-color:rgba(0,0,0,.75);font-size:32rpx;text-align:center;color:#fff;word-break:break-all}