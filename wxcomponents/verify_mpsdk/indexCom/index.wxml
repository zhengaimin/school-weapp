<import src="../templates/riskTip/riskTip.wxml"></import><block wx:if="{{!showAuthGuide}}"><view class="fix-full-page {{theme}} {{verifyPageLoading ? 'fullpageloading' : ''}}" style="background-color: {{rtLive.isChangeColor ? rtLive.currentColor : 'transparent'}}"><block><navtip navTipTitle="{{navTipTitle}}" stepList="{{stepList}}" visible="{{curPage && curPage !== 'Index'}}" theme="{{theme}}" isShowBlock="{{rtLive.isChangeColor}}" cmsConfig="{{cmsConfig}}" curPage="{{curPage}}" bind:getCurrentIndex="getCurrentIndex"/></block><block wx:if="{{curPage === 'Index' && !cmsConfig.IsHideIndexAlways}}"><flow-index token="{{token}}" bind:next="nextFlow" theme="{{theme}}" cmsConfig="{{cmsConfig}}"><template is="riskTip" wx:if="{{cmsConfig.Common.RiskTip}}" data="{{riskTip: cmsConfig.Common.RiskTip}}"></template></flow-index></block><block wx:if="{{curPage === 'Sms'}}"><flow-sms token="{{token}}" bind:next="nextFlow" theme="{{theme}}" cmsConfig="{{cmsConfig}}"><template is="riskTip" wx:if="{{cmsConfig.Common.RiskTip}}" data="{{riskTip: cmsConfig.Common.RiskTip}}"></template></flow-sms></block><block wx:if="{{curPage === 'Ocr'}}"><flow-ocr themeLayout="{{themeLayout}}" id="ocr-flow" token="{{token}}" bind:notify="onNotify" bind:next="nextFlow" theme="{{theme}}" cmsConfig="{{cmsConfig}}"><view slot="default"><template is="riskTip" wx:if="{{cmsConfig.Common.RiskTip}}" data="{{riskTip: cmsConfig.Common.RiskTip,isCoverView: false}}"></template></view><cover-view slot="cover"><template is="riskTip" wx:if="{{cmsConfig.Common.RiskTip}}" data="{{riskTip: cmsConfig.Common.RiskTip,isCoverView: true}}"></template></cover-view></flow-ocr></block><block wx:if="{{curPage === 'Livingbody'}}"><flow-livingbody themeLayout="{{themeLayout}}" livingbodyType="{{livingbodyType}}" theme="{{theme}}" bind:notify="onNotify" bind:next="nextFlow" token="{{token}}" cmsConfig="{{cmsConfig}}" livingbody="{{livingbody}}" isInfinityDisplay="{{isInfinityDisplay}}"><view slot="default"><template is="riskTip" wx:if="{{cmsConfig.Common.RiskTip}}" data="{{riskTip: cmsConfig.Common.RiskTip,isCoverView: false}}"></template></view><cover-view slot="cover"><template is="riskTip" wx:if="{{cmsConfig.Common.RiskTip}}" data="{{riskTip: cmsConfig.Common.RiskTip,isCoverView: true}}"></template></cover-view></flow-livingbody></block><block wx:if="{{curPage === 'Result'}}"><flow-result theme="{{theme}}" livingbodyType="{{livingbodyType}}" token="{{token}}" success-info="{{cmsConfig.page}}" result-info="{{ resultInfo}}" cmsConfig="{{cmsConfig}}" bizData="{{bizData}}" retry-type="{{retryType}}" bind:success="exitVerify" bind:retry="handleRetry" bind:back="handleBack" bind:voice="checkVoice" bind:finish="handleFinish"/></block><block wx:if="{{curPage === 'RTLive'}}"><flow-rt-live cmsConfig="{{cmsConfig}}" needGuid="{{needGuid}}" theme="{{theme}}" id="rtlive" token="{{token}}" rtLiveToken="{{rtLiveToken}}" bind:next="nextFlow" bind:notify="onNotify" bind:authError="handleShowAuthGuide" bind:colorChange="handleChangeColor"/></block></view></block><dialog wx:if="{{showErrorMsg}}" showHeaderIcon="{{true}}" title="{{err.ErrorMsg}}" confirm-color="{{ErrorDialogConfig.confirmColor}}" confirm-text="我知道了" show-cancel="{{false}}" bindconfirm="switchDialog"><view wx:if="{{err.error_msg == 'OCR识别失败' || err.error_msg == '证件日期识别失败'}}" class="faceid-dialog__hd" style="margin-bottom:0"><view><label style="color:#989898;" wx:if="{{err.error_msg == 'OCR识别失败'}}">请根据规范重新拍摄</label> <label style="color:#989898;" wx:if="{{err.error_msg == '证件日期识别失败'}}">请按规范重新拍摄</label><image src="https://faceid-h5-1254418846.file.myqcloud.com/mp_verify_sdk/images/ocr-fail.png" style="width:100%;height:150px;margin:50rpx 0;"></image></view></view></dialog><dialog wx:if="{{showAuthGuide}}" theme="transparent" opacity="{{0.8}}" title="授权出错" show-cancel="{{false}}" show-confirm="{{false}}"><view style="padding:0 0.8em 0.8em;min-height:40px;font-size:15px;line-height:1.3;word-wrap:break-word;word-break:break-all;color:#999999;"><view>请您按照指引关闭并清除小程序后，再重新打开。</view><view><view style="margin:20rpx 0">参考视频:</view><video style="width:100%" object-fit="contain" src="{{cmsConfig.page.rtLive.denyGuideVideo || 'https://faceid-h5-1254418846.cos.ap-guangzhou.myqcloud.com/mp_verify_sdk/images/video/del-sdk.mov'}}"></video></view></view></dialog><cus-notify id="cus-notify"/>