{
  "excludePathPatterns": [],
  "naming": {
    "enabled": true
  },
  "grouping": {
    "enabled": true
  },
  "constantExtraction": {
    "enabled": true,
    "literalRepeatThreshold": 4,
    "ignore": [
      "",
      "0",
      "1",
      "-1",
      "true",
      "false",
      "utf8"
    ],
    "ignorePathPatterns": [
      "**/templates/**"
    ]
  }
}
